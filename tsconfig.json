{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    /* The htmx/alpine JSX augmentations are pulled in by src/globals.d.ts. */
    "types": ["bun-types"],

    /* Server-side JSX: components render straight to an HTML string.
       The runtime lives in @kitajs/html; @elysiajs/html only wires it into Elysia. */
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* TypeScript 7 removed baseUrl; paths are relative to this file. */
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "public/vendor"]
}
