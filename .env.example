# ---- Database -------------------------------------------------------------
# Local docker-compose stack (see docker-compose.yml)
DATABASE_URL="postgresql://goodplaner:goodplaner@localhost:5432/goodplaner?schema=public"

# ---- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
#  1. Create an OAuth 2.0 Client ID of type "Web application"
#  2. Authorised redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"

# Signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Development-only escape hatch: lets you sign in without Google credentials.
# Ignored entirely when NODE_ENV=production.
DEV_AUTH_ENABLED="false"

# NOTE: port 3000 is often already taken by another dev server.
# If `bun run dev` shows someone else's app, change PORT and APP_URL together
# (the Google redirect URI must match APP_URL exactly).
